<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />
    <include resource="org/springframework/boot/logging/logback/console-appender.xml" />

    <!-- Define our clean programmatic Azure Blob Appender -->
    <appender name="AZURE_BLOB" class="com.employee.logging.AzureBlobAppender">
        <blobPrefix>springboot-app-</blobPrefix>
    </appender>

    <appender name="ASYNC_AZURE_BLOB" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="AZURE_BLOB" />
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ASYNC_AZURE_BLOB" />
    </root>
</configuration>
